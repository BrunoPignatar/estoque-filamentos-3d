<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <header>
      <h1><%= title %></h1>
      <p>Controle dos rolos de filamento da impressora 3D</p>
    </header>

    <main>
      <section class="card">
        <h2>Cadastrar filamento</h2>
        <% if (erro) { %>
          <p class="erro"><%= erro %></p>
        <% } %>
        <form action="/itens" method="POST">
          <div class="campo">
            <label for="marca">Marca</label>
            <input type="text" id="marca" name="marca" required>
          </div>
          <div class="campo">
            <label for="material">Material</label>
            <select id="material" name="material" required>
              <option value="PLA">PLA</option>
              <option value="PETG">PETG</option>
              <option value="ABS">ABS</option>
              <option value="TPU">TPU</option>
            </select>
          </div>
          <div class="campo">
            <label for="cor">Cor</label>
            <input type="text" id="cor" name="cor" required>
          </div>
          <div class="campo">
            <label for="peso">Peso (g)</label>
            <input type="number" id="peso" name="peso" min="0" required>
          </div>
          <div class="campo">
            <label for="preco">Preço (R$)</label>
            <input type="number" id="preco" name="preco" min="0" step="0.01" required>
          </div>
          <button type="submit">Salvar</button>
        </form>
      </section>

      <section class="card">
        <h2>Filamentos cadastrados</h2>
        <% if (filamentos.length == 0) { %>
          <p>Nenhum filamento cadastrado.</p>
        <% } else { %>
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Marca</th>
                <th>Material</th>
                <th>Cor</th>
                <th>Peso (g)</th>
                <th>Preço (R$)</th>
                <th>Ações</th>
              </tr>
            </thead>
            <tbody>
              <% filamentos.forEach(function(f) { %>
                <tr>
                  <td><%= f.id %></td>
                  <td><%= f.marca %></td>
                  <td><%= f.material %></td>
                  <td><%= f.cor %></td>
                  <td><%= f.peso %></td>
                  <td><%= Number(f.preco).toFixed(2) %></td>
                  <td><a href="/itens/<%= f.id %>/editar">Editar</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </section>
    </main>
  </body>
</html>
