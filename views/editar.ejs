<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <header>
      <h1>Estoque de Filamentos 3D</h1>
      <p>Controle dos rolos de filamento da impressora 3D</p>
    </header>

    <main>
      <section class="card">
        <h2>Editar filamento #<%= filamento.id %></h2>
        <% if (erro) { %>
          <p class="erro"><%= erro %></p>
        <% } %>
        <form action="/itens/<%= filamento.id %>/editar" method="POST">
          <div class="campo">
            <label for="marca">Marca</label>
            <input type="text" id="marca" name="marca" value="<%= filamento.marca %>" required>
          </div>
          <div class="campo">
            <label for="material">Material</label>
            <select id="material" name="material" required>
              <% ['PLA', 'PETG', 'ABS', 'TPU'].forEach(function(m) { %>
                <option value="<%= m %>" <%= filamento.material == m ? 'selected' : '' %>><%= m %></option>
              <% }) %>
            </select>
          </div>
          <div class="campo">
            <label for="cor">Cor</label>
            <input type="text" id="cor" name="cor" value="<%= filamento.cor %>" required>
          </div>
          <div class="campo">
            <label for="peso">Peso (g)</label>
            <input type="number" id="peso" name="peso" min="0" value="<%= filamento.peso %>" required>
          </div>
          <div class="campo">
            <label for="preco">Preço (R$)</label>
            <input type="number" id="preco" name="preco" min="0" step="0.01" value="<%= filamento.preco %>" required>
          </div>
          <button type="submit">Salvar</button>
          <a href="/" class="voltar">Voltar</a>
        </form>
      </section>
    </main>
  </body>
</html>
